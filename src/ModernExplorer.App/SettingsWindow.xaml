                                        <Button Tag="CodeDocument:#22C55E" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#22C55E" /></Button>
                                        <Button Tag="CodeDocument:#14B8A6" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#14B8A6" /></Button>
                                        <Button Tag="CodeDocument:#84CC16" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#84CC16" /></Button>
                                    </StackPanel>
                                    <TextBox x:Name="TreemapCodeHexBox" Grid.Column="3" Text="{x:Bind Settings.TreemapCodeDocumentColor, Mode=OneWay}" PlaceholderText="#10B981" />
                                    <Button x:Name="TreemapApplyBtn4" Grid.Column="4" Tag="CodeDocument" Content="Übernehmen" Click="OnApplyTreemapHexColorClick" />
                                </Grid>

                                <!-- Category 4: Bilder & Grafiken -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{x:Bind local:ShellIconConverter.HexToBrush(Settings.TreemapPictureGraphicColor), Mode=OneWay}" />
                                    <TextBlock x:Name="TreemapCatPictureLabel" Grid.Column="1" Text="🖼️ Bilder &amp; Grafiken (.png, .jpg, .psd)" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Tag="PictureGraphic:#06B6D4" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#06B6D4" /></Button>
                                        <Button Tag="PictureGraphic:#38BDF8" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#38BDF8" /></Button>
                                        <Button Tag="PictureGraphic:#0284C7" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#0284C7" /></Button>
                                        <Button Tag="PictureGraphic:#F43F5E" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#F43F5E" /></Button>
                                    </StackPanel>
                                    <TextBox x:Name="TreemapPictureHexBox" Grid.Column="3" Text="{x:Bind Settings.TreemapPictureGraphicColor, Mode=OneWay}" PlaceholderText="#06B6D4" />
                                    <Button x:Name="TreemapApplyBtn5" Grid.Column="4" Tag="PictureGraphic" Content="Übernehmen" Click="OnApplyTreemapHexColorClick" />
                                </Grid>

                                <!-- Category 5: Programme & Bibliotheken -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{x:Bind local:ShellIconConverter.HexToBrush(Settings.TreemapBinaryExecutableColor), Mode=OneWay}" />
                                    <TextBlock x:Name="TreemapCatBinaryLabel" Grid.Column="1" Text="⚙️ Programme &amp; Binaries (.exe, .dll …)" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Tag="BinaryExecutable:#EAB308" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#EAB308" /></Button>
                                        <Button Tag="BinaryExecutable:#F59E0B" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#F59E0B" /></Button>
                                        <Button Tag="BinaryExecutable:#FACC15" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#FACC15" /></Button>
                                        <Button Tag="BinaryExecutable:#D97706" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#D97706" /></Button>
                                    </StackPanel>
                                    <TextBox x:Name="TreemapBinaryHexBox" Grid.Column="3" Text="{x:Bind Settings.TreemapBinaryExecutableColor, Mode=OneWay}" PlaceholderText="#EAB308" />
                                    <Button x:Name="TreemapApplyBtn6" Grid.Column="4" Tag="BinaryExecutable" Content="Übernehmen" Click="OnApplyTreemapHexColorClick" />
                                </Grid>

                                <!-- Category 6: Sonstige & Temp -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{x:Bind local:ShellIconConverter.HexToBrush(Settings.TreemapOtherTempColor), Mode=OneWay}" />
                                    <TextBlock x:Name="TreemapCatOtherLabel" Grid.Column="1" Text="🗂️ Sonstige &amp; Temp-Dateien" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Tag="OtherTemp:#64748B" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#64748B" /></Button>
                                        <Button Tag="OtherTemp:#475569" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#475569" /></Button>
                                        <Button Tag="OtherTemp:#94A3B8" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#94A3B8" /></Button>
                                        <Button Tag="OtherTemp:#78716C" Click="OnTreemapColorPresetClick" Padding="6,5"><Border Width="14" Height="12" CornerRadius="2" Background="#78716C" /></Button>
                                    </StackPanel>
                                    <TextBox x:Name="TreemapOtherHexBox" Grid.Column="3" Text="{x:Bind Settings.TreemapOtherTempColor, Mode=OneWay}" PlaceholderText="#64748B" />
                                    <Button x:Name="TreemapApplyBtn7" Grid.Column="4" Tag="OtherTemp" Content="Übernehmen" Click="OnApplyTreemapHexColorClick" />
                                </Grid>

                                <Button x:Name="ResetTreemapColorsButton"
                                        Content="Treemap-Farben auf Standardwerte zurücksetzen"
                                        Click="OnResetTreemapColorsClick"
                                        Padding="12,6"
                                        FontSize="12.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 3: FILE LIST & BEHAVIOR                          -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="CategoryBehaviorPanel" Spacing="18" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="BehaviorHeaderTitle" Text="Dateiliste &amp; Verhalten" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="BehaviorHeaderSub" Text="Steuern Sie Sortierung, Dateiendungen, versteckte Dateien und Sicherheitsabfragen."
                                       FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="DefaultViewModeTitle"
                                           Text="Standard-Ansichtsmodus für neue Tabs"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DefaultViewModeDesc"
                                           Text="Legt fest, mit welchem Ansichtsmodus neu geöffnete Explorer-Tabs starten."
                                           FontSize="12.5"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="DefaultViewModeComboBox"
                                          Width="340"
                                          SelectionChanged="OnDefaultViewModeSelectionChanged" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="14">
                                <ToggleSwitch x:Name="ToggleFoldersFirst"
                                              Header="Ordner immer vor Dateien sortieren"
                                              IsOn="{x:Bind Settings.SortFoldersFirst, Mode=TwoWay}"
                                              OnContent="Aktiv – Ordner stehen immer oben in der Liste"
                                              OffContent="Inaktiv – Ordner und Dateien werden gemeinsam sortiert" />

                                <ToggleSwitch x:Name="ToggleFileExtensions"
                                              Header="Dateiendungen in der Namensspalte anzeigen"
                                              IsOn="{x:Bind Settings.ShowFileExtensions, Mode=TwoWay}"
                                              OnContent="Aktiv – Voller Dateiname inkl. Endung (z. B. bericht.pdf)"
                                              OffContent="Inaktiv – Endung nur in der Spalte 'Typ' anzeigen" />

                                <ToggleSwitch x:Name="ToggleHiddenFiles"
                                              Header="Versteckte Dateien standardmäßig anzeigen (Strg+H)"
                                              IsOn="{x:Bind Settings.ShowHiddenFilesByDefault, Mode=TwoWay}"
                                              OnContent="Aktiv – Versteckte Elemente werden eingeblendet"
                                              OffContent="Inaktiv – Versteckte Elemente sind ausgeblendet" />

                                <ToggleSwitch x:Name="ToggleFolderSizeOnMark"
                                              Header="Ordnergröße beim Markieren mit Leertaste automatisch berechnen"
                                              IsOn="{x:Bind Settings.AutoCalculateFolderSizeOnMark, Mode=TwoWay}"
                                              OnContent="Aktiv – Berechnet die Gesamtgröße des Ordners im Hintergrund"
                                              OffContent="Inaktiv – Keine automatische Größenberechnung" />

                                <ToggleSwitch x:Name="ToggleConfirmRecycleBin"
                                              Header="Bestätigungsdialog beim Löschen in den Papierkorb (F8 / Entf)"
                                              IsOn="{x:Bind Settings.ConfirmDeleteToRecycleBin, Mode=TwoWay}"
                                              OnContent="Aktiv – Vor dem Verschieben in den Papierkorb nachfragen"
                                              OffContent="Inaktiv – Sofort ohne Rückfrage in den Papierkorb verschieben" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 4: IMAGE PREVIEW                                 -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="CategoryPreviewPanel" Spacing="18" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="PreviewHeaderTitle" Text="Bildvorschau (Hover &amp; Quick-Viewer)" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreviewHeaderSub" Text="Konfigurieren Sie die automatische Bildvorschau beim Überfahren von Bilddateien mit der Maus."
                                       FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="14">
                                <ToggleSwitch x:Name="ToggleImageHoverPreview"
                                              Header="Bildvorschau beim Überfahren mit der Maus (Hover-Preview)"
                                              IsOn="{x:Bind Settings.EnableImageHoverPreview, Mode=TwoWay}"
                                              OnContent="Aktiv – Zeigt ein Vorschaubild neben dem Mauszeiger an"
                                              OffContent="Inaktiv – Keine Hover-Vorschau" />

                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock x:Name="PreviewMaxSizeLabel" Text="Maximale Größe der Hover-Bildvorschau" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.ImageHoverPreviewSizeText, Mode=OneWay}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.85" />
                                    </Grid>
                                    <Slider Minimum="160" Maximum="720" StepFrequency="20"
                                            Value="{x:Bind Settings.ImageHoverPreviewSize, Mode=TwoWay}" />
                                </StackPanel>

                                <TextBlock x:Name="PreviewFormatsNote"
                                           Text="Unterstützte Bildformate: PNG, JPG/JPEG, GIF, BMP, WEBP, ICO, TIF/TIFF, JFIF. Die Fenster der F3-Schnellansicht und des F4-Editors können zusätzlich frei mit der Maus skaliert werden."
                                           FontSize="12"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 5: FONT SIZES                                    -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="CategoryFontsPanel" Spacing="18" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="FontsHeaderTitle" Text="Schriftgrößen (Global, Hauptfenster &amp; Child-Fenster)" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="FontsHeaderSub" Text="Verwenden Sie vereinfacht eine globale Schriftgröße für die gesamte App oder passen Sie jedes UI-Element und jedes Child-Fenster einzeln an."
                                       FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 1. Simplified Global Font Size Card (Optionshaken) -->
                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="FontGlobalCardTitle"
                                           Text="🌐 Vereinfachte globale Schriftgröße (für gesamte App &amp; alle Child-Fenster)"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <CheckBox x:Name="UseGlobalFontSizeCheckBox"
                                          Content="Vereinfacht nur eine Schriftgröße einstellen und global für das Hauptfenster sowie alle Child-Fenster verwenden"
                                          IsChecked="{x:Bind Settings.UseGlobalFontSize, Mode=TwoWay}"
                                          FontWeight="SemiBold" />
                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontGlobalSliderLabel" Text="Globale Schriftgröße (wird überall angewendet, wenn Haken gesetzt)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.GlobalFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold" Opacity="0.9" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            Value="{x:Bind Settings.GlobalFontSize, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Main Window UI Elements Card -->
                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="FontMainWinCardTitle"
                                           Text="🖥️ Hauptfenster – UI-Bereiche einzeln anpassen"
                                           FontSize="15"
                                           FontWeight="SemiBold" />

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontFileListLabel" Text="Dateiliste (Dateinamen &amp; Ordner)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.FileListFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="9" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.FileListFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontFileListDetailsLabel" Text="Dateiliste Details &amp; Spaltenköpfe (Größe, Datum, Typ)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.FileListDetailsFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="22" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.FileListDetailsFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontTabsLabel" Text="Tabs (Tab-Leiste)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.TabFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="9" Maximum="22" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.TabFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontDriveBarLabel" Text="Laufwerksleiste (Laufwerks-Buttons)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.DriveBarFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="9" Maximum="22" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.DriveBarFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontAddressBarLabel" Text="Adressleiste &amp; Filterfeld" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.AddressBarFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="9" Maximum="22" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.AddressBarFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontBreadcrumbsLabel" Text="Breadcrumbs (Pfad-Segmente)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.BreadcrumbFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="20" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.BreadcrumbFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontStatusBarLabel" Text="Statusleiste (Unten im Panel)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.StatusBarFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="20" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.StatusBarFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontFunctionBarLabel" Text="Funktionsleiste (F1–F12 Buttons)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.FunctionBarFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="20" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.FunctionBarFontSize, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Child Windows Individual Font Sizes Card -->
                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="FontChildWinCardTitle"
                                           Text="🪟 Child-Fenster – Schriftgröße für jedes Child-Fenster einzeln anpassen"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="FontChildWinCardDesc"
                                           Text="Steuert die Schriftgröße in den einzelnen Werkzeug- und Vorschaufenstern (sofern oben nicht die globale Schriftgröße aktiviert ist)."
                                           FontSize="12.5"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontQuickViewerLabel" Text="👁️ Quick-Viewer / Schnellansicht (F3)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.QuickViewerFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.QuickViewerFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontEditorLabel" Text="✏️ Interner Text- &amp; Code-Editor (F4)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.EditorFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.EditorFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontStorageAnalyzerLabel" Text="🗺️ Speicherplatz-Analysator &amp; Treemap (Strg+Shift+W)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.StorageAnalyzerFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.StorageAnalyzerFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontDeepSearchLabel" Text="🔍 Rekursive Tiefensuche (Alt+F7)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.DeepSearchFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.DeepSearchFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontDuplicateFinderLabel" Text="🧹 Duplikat-Finder (SHA-256)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.DuplicateFinderFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.DuplicateFinderFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontDirectorySyncLabel" Text="⇄ Verzeichnisse vergleichen &amp; synchronisieren (Strg+Shift+S)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.DirectorySyncFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.DirectorySyncFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontBatchRenameLabel" Text="🏷️ Mehrfach-Umbenennungstool (Strg+M)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.BatchRenameFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.BatchRenameFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontFtpManagerLabel" Text="🌐 FTP / FTPS / SFTP Verbindungsmanager" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.FtpManagerFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.FtpManagerFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontArchiveDialogLabel" Text="📦 In Archiv packen (Alt+F5)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.ArchiveDialogFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.ArchiveDialogFontSize, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock x:Name="FontAboutWindowLabel" Text="ℹ️ Über ModernExplorer &amp; Hilfe-Fenster (F1)" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Settings.AboutWindowFontSizeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                    </Grid>
                                    <Slider Minimum="8" Maximum="24" StepFrequency="0.5"
                                            IsEnabled="{x:Bind Settings.IsIndividualFontSizesEnabled, Mode=OneWay}"
                                            Value="{x:Bind Settings.AboutWindowFontSize, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ResetFontSizesButton"
                                Content="Schriftgrößen auf Standardwerte zurücksetzen"
                                Click="OnResetFontSizesClick"
                                Padding="12,6"
                                FontSize="12.5" />
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 6: SESSION, UPDATES & WINDOWS                    -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="CategorySessionPanel" Spacing="18" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SessionHeaderTitle" Text="Sitzung, Updates &amp; Fenster" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="SessionHeaderSub" Text="Verwalten Sie die automatische Update-Prüfung auf GitHub, die Session-Speicherung sowie Ihre Fenstergrößen."
                                       FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- GitHub Release Update Check Card -->
                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="UpdateCardTitle"
                                           Text="🚀 Automatische Update-Prüfung (GitHub Releases)"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="ToggleCheckUpdatesStartup"
                                              Header="Beim Programmstart automatisch auf GitHub nach neuen Releases suchen"
                                              IsOn="{x:Bind Settings.CheckForUpdatesOnStartup, Mode=TwoWay}"
                                              OnContent="Aktiv – Informiert bei einem neuen Release und bietet ein direktes Update an"
                                              OffContent="Inaktiv – Nur manuelle Update-Prüfung" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="CheckUpdatesNowButton"
                                            Content="Jetzt auf Updates prüfen"
                                            Click="OnCheckForUpdatesClick"
                                            Padding="12,6"
                                            FontSize="12.5" />
                                    <TextBlock x:Name="InstalledVersionLabel"
                                               VerticalAlignment="Center"
                                               FontSize="12.5"
                                               Opacity="0.8" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Session Persistence Card -->
                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="SessionCardTitle"
                                           Text="Session speichern &amp; Startverhalten"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="ToggleSaveSession"
                                              Header="Session speichern aktivieren"
                                              IsOn="{x:Bind Settings.SaveSession, Mode=TwoWay}"
                                              OnContent="Aktiv – Tabs, geöffnete Pfade &amp; Layout werden gespeichert"
                                              OffContent="Inaktiv – Startet immer mit Standard-Ordnern" />
                                <TextBlock x:Name="SessionCardDesc"
                                           Text="Wenn aktiv, werden alle geöffneten Tabs, deren Pfade, das zuletzt gewählte Element, Pin-/Sperrstatus, Sortierungen und das Panel-Layout automatisch gesichert und beim nächsten Programmstart wiederhergestellt."
                                           FontSize="12"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <Button x:Name="SaveSessionNowButton"
                                        Content="Aktuelle Session jetzt sofort speichern"
                                        Click="OnSaveSessionNowClick"
                                        Padding="12,6"
                                        FontSize="12.5" />
                            </StackPanel>
                        </Border>

                        <!-- Window Bounds Card -->
                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="WindowBoundsCardTitle"
                                           Text="Gespeicherte Fenstergrößen"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="WindowBoundsCardDesc"
                                           Text="ModernExplorer merkt sich automatisch die zuletzt verwendete Größe und den Maximiert-Status des Hauptfensters sowie aller Child-Fenster:"
                                           FontSize="12.5"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />

                                <Grid RowSpacing="6" ColumnSpacing="16" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="BoundsMainWinLabel" Grid.Row="0" Grid.Column="0" Text="Hauptfenster:" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Settings.MainWindowBoundsSummary, Mode=OneWay}" FontSize="12.5" Opacity="0.85" />

                                    <TextBlock x:Name="BoundsSettingsWinLabel" Grid.Row="1" Grid.Column="0" Text="Einstellungsfenster:" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Settings.SettingsWindowBoundsSummary, Mode=OneWay}" FontSize="12.5" Opacity="0.85" />

                                    <TextBlock x:Name="BoundsChildWinLabel" Grid.Row="2" Grid.Column="0" Text="Vorschau (F3) / Editor (F4):" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Settings.ChildWindowBoundsSummary, Mode=OneWay}" FontSize="12.5" Opacity="0.85" />
                                </Grid>

                                <Button x:Name="ResetWindowBoundsButton"
                                        Content="Fenstergrößen auf Standardwerte zurücksetzen"
                                        Click="OnResetWindowBoundsClick"
                                        Padding="12,6"
                                        FontSize="12.5" />
                            </StackPanel>
                        </Border>

                        <!-- Reset to Factory Defaults Card -->
                        <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="FactoryResetCardTitle"
                                           Text="Werkseinstellungen wiederherstellen"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="FactoryResetCardDesc"
                                           Text="Setzt alle Farben, Schriftgrößen, Anzeigeoptionen, Verhaltensregeln und Fenstergrößen auf die Standardwerte zurück:"
                                           FontSize="12.5"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <Button x:Name="FactoryResetButton"
                                        Content="Alle Einstellungen auf Werkseinstellungen zurücksetzen"
                                        Click="OnResetAllSettingsClick"
                                        Padding="12,6"
                                        FontSize="12.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ======================= FOOTER ======================= -->
        <Border Grid.Row="2"
                Padding="20,10"
                Background="{ThemeResource ExplorerStatusBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="SettingsFooterNote"
                           Text="Alle Änderungen werden automatisch in %APPDATA%\ModernExplorer\settings.json gespeichert."
                           FontSize="12"
                           Opacity="0.7"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseSettingsButton"
                        Content="Schließen (Esc)"
                        HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        Padding="18,6" />
            </Grid>
        </Border>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ModernExplorer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ======================= DARK THEME ======================= -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ExplorerWindowBackgroundBrush" Color="#FF18181D" />
                    <SolidColorBrush x:Key="ExplorerTitleBarBackgroundBrush" Color="#FF1F1F26" />
                    <SolidColorBrush x:Key="ExplorerPanelBackgroundBrush" Color="#FF1D1D24" />
                    <SolidColorBrush x:Key="ExplorerDriveBarBackgroundBrush" Color="#FF25252F" />
                    <SolidColorBrush x:Key="ExplorerTabBarBackgroundBrush" Color="#FF21212A" />
                    <SolidColorBrush x:Key="ExplorerColumnHeaderBackgroundBrush" Color="#FF272732" />
                    <SolidColorBrush x:Key="ExplorerStatusBarBackgroundBrush" Color="#FF202029" />
                    <SolidColorBrush x:Key="ExplorerFunctionBarBackgroundBrush" Color="#FF1E1E26" />
                    <SolidColorBrush x:Key="ExplorerSettingsBackgroundBrush" Color="#FF23232D" />
                    <SolidColorBrush x:Key="ExplorerCardBackgroundBrush" Color="#FF2B2B37" />
                    <SolidColorBrush x:Key="ExplorerOverlayBackdropBrush" Color="#88000000" />
                </ResourceDictionary>

                <!-- ======================= LIGHT THEME ======================= -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ExplorerWindowBackgroundBrush" Color="#FFF3F4F7" />
                    <SolidColorBrush x:Key="ExplorerTitleBarBackgroundBrush" Color="#FFE8EBF0" />
                    <SolidColorBrush x:Key="ExplorerPanelBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ExplorerDriveBarBackgroundBrush" Color="#FFF0F2F6" />
                    <SolidColorBrush x:Key="ExplorerTabBarBackgroundBrush" Color="#FFE9ECF2" />
                    <SolidColorBrush x:Key="ExplorerColumnHeaderBackgroundBrush" Color="#FFF4F6FA" />
                    <SolidColorBrush x:Key="ExplorerStatusBarBackgroundBrush" Color="#FFEEF1F6" />
                    <SolidColorBrush x:Key="ExplorerFunctionBarBackgroundBrush" Color="#FFE8EBF0" />
                    <SolidColorBrush x:Key="ExplorerSettingsBackgroundBrush" Color="#FFFAFBFD" />
                    <SolidColorBrush x:Key="ExplorerCardBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ExplorerOverlayBackdropBrush" Color="#55000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

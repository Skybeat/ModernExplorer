<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernExplorer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernExplorer.App"
    xmlns:vm="using:ModernExplorer.Core.ViewModels"
    xmlns:fav="using:ModernExplorer.Core.Favorites"
    Title="ModernExplorer">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ExplorerWindowBackgroundBrush}"
          KeyDown="OnRootKeyDown"
          KeyUp="OnRootKeyUp">

        <Grid.Resources>
            <!-- ItemsPanelTemplates for the 8 Windows Explorer View Modes -->
            <ItemsPanelTemplate x:Key="VerticalStackItemsPanel">
                <ItemsStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="ExtraLargeIconsItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="168" ItemHeight="180" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="LargeIconsItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="124" ItemHeight="132" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="MediumIconsItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="104" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="SmallIconsItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="172" ItemHeight="32" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="ListItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" ItemHeight="28" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="TilesItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="260" ItemHeight="64" />
            </ItemsPanelTemplate>

            <!-- 1. Details View (Details) -->
            <DataTemplate x:Key="DetailsItemTemplate" x:DataType="vm:FileItemViewModel">
                <Border BorderThickness="1.5"
                        CornerRadius="4"
                        Padding="4,1"
                        MinHeight="{x:Bind Settings.FileListRowHeight, Mode=OneWay}"
                        Background="Transparent"
                        BorderBrush="{x:Bind local:ShellIconConverter.SelectionBorderBrush(IsFocused, Settings.SelectionBorderColor), Mode=OneWay}"
                        PointerEntered="OnFileItemPointerEntered"
                        PointerMoved="OnFileItemPointerMoved"
                        PointerExited="OnFileItemPointerExited"
                        RightTapped="OnFileItemRightTapped">
                    <Grid Opacity="{x:Bind Opacity, Mode=OneWay}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="75" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="✓"
                                   FontWeight="Bold"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   Visibility="{x:Bind IsMarked, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Image Grid.Column="1"
                               Source="{x:Bind local:ShellIconConverter.ToImageSource(Entry), Mode=OneWay}"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" />
                        <Grid Grid.Column="2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind DisplayName, Mode=OneWay}"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FontSize="{x:Bind Settings.FileListFontSize, Mode=OneWay}" />
                            <Border Grid.Column="1"
                                    Visibility="{x:Bind HasTag, Mode=OneWay}"
                                    Background="{x:Bind local:ShellIconConverter.HexToBrush(TagColorHex), Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind local:ShellIconConverter.OptionalToolTip(TagTooltipText, Settings.ShowToolTips), Mode=OneWay}"
                                    CornerRadius="3"
                                    Padding="5,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind TagBadgeText, Mode=OneWay}"
                                           Foreground="White"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           MaxWidth="140"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Grid.Column="2"
                                    Visibility="{x:Bind HasGitStatusBadge, Mode=OneWay}"
                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                    CornerRadius="3"
                                    Padding="4,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind GitStatusBadge, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           FontSize="10.5"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <Grid Grid.Column="3">
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Height="14"
                                    CornerRadius="3"
                                    Width="{x:Bind SizeBarWidth, Mode=OneWay}"
                                    Visibility="{x:Bind HasSizeBar, Mode=OneWay}"
                                    Background="{ThemeResource SystemAccentColor}"
                                    Opacity="0.28" />
                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Opacity="0.85"
                                       FontSize="{x:Bind Settings.FileListDetailsFontSize, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Grid.Column="4"
                                   Text="{x:Bind ModifiedText, Mode=OneWay}"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Opacity="0.8"
                                   FontSize="{x:Bind Settings.FileListDetailsFontSize, Mode=OneWay}" />
                        <TextBlock Grid.Column="5"
                                   Text="{x:Bind TypeText, Mode=OneWay}"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75"
                                   FontSize="{x:Bind Settings.FileListDetailsFontSize, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 2. Content View (Inhalt) -->
            <DataTemplate x:Key="ContentItemTemplate" x:DataType="vm:FileItemViewModel">
                <Border BorderThickness="1.5"
                        CornerRadius="4"
                        Padding="8,5"
                        MinHeight="50"
                        Background="Transparent"
                        BorderBrush="{x:Bind local:ShellIconConverter.SelectionBorderBrush(IsFocused, Settings.SelectionBorderColor), Mode=OneWay}"
                        PointerEntered="OnFileItemPointerEntered"
                        PointerMoved="OnFileItemPointerMoved"
                        PointerExited="OnFileItemPointerExited"
                        RightTapped="OnFileItemRightTapped">
                    <Grid Opacity="{x:Bind Opacity, Mode=OneWay}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="✓"
                                   FontWeight="Bold"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   Visibility="{x:Bind IsMarked, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Image Grid.Column="1"
                               Source="{x:Bind local:ShellIconConverter.ToLargeImageSource(Entry), Mode=OneWay}"
                               Width="32"
                               Height="32"
                               Stretch="Uniform"
                               VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{x:Bind Settings.FileListFontSize, Mode=OneWay}" />
                                <Border Visibility="{x:Bind HasTag, Mode=OneWay}"
                                        Background="{x:Bind local:ShellIconConverter.HexToBrush(TagColorHex), Mode=OneWay}"
                                        CornerRadius="3"
                                        Padding="5,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind TagBadgeText, Mode=OneWay}"
                                               Foreground="White"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind TypeText, Mode=OneWay}"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{x:Bind Settings.FileListDetailsFontSize, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind ContentModifiedLabelText, Mode=OneWay}"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Opacity="0.8"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{x:Bind Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ContentSizeLabelText, Mode=OneWay}"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Opacity="0.75"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{x:Bind Settings.FileListDetailsFontSize, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 3. Tiles View (Kacheln) -->
            <DataTemplate x:Key="TilesItemTemplate" x:DataType="vm:FileItemViewModel">
                <Border BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="6,4"
                        Width="252"
                        Height="58"
                        Background="Transparent"
                        BorderBrush="{x:Bind local:ShellIconConverter.SelectionBorderBrush(IsFocused, Settings.SelectionBorderColor), Mode=OneWay}"
                        PointerEntered="OnFileItemPointerEntered"
                        PointerMoved="OnFileItemPointerMoved"
                        PointerExited="OnFileItemPointerExited"
                        RightTapped="OnFileItemRightTapped">
                    <Grid Opacity="{x:Bind Opacity, Mode=OneWay}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                            <Image Source="{x:Bind local:ShellIconConverter.ToLargeImageSource(Entry), Mode=OneWay}"
                                   Width="40"
                                   Height="40"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="✓"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Visibility="{x:Bind IsMarked, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{x:Bind Settings.FileListFontSize, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind TypeText, Mode=OneWay}"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Opacity="0.72"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11.5" />
                            <TextBlock Text="{x:Bind TileSecondaryText, Mode=OneWay}"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Opacity="0.62"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 4. Extra Large Icons View (Extra große Symbole) -->
            <DataTemplate x:Key="ExtraLargeIconsItemTemplate" x:DataType="vm:FileItemViewModel">
                <Border BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="6"
                        Width="160"
                        Height="172"
                        Background="Transparent"
                        BorderBrush="{x:Bind local:ShellIconConverter.SelectionBorderBrush(IsFocused, Settings.SelectionBorderColor), Mode=OneWay}"
                        PointerEntered="OnFileItemPointerEntered"
                        PointerMoved="OnFileItemPointerMoved"
                        PointerExited="OnFileItemPointerExited"
                        RightTapped="OnFileItemRightTapped">
                    <Grid Opacity="{x:Bind Opacity, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Image Source="{x:Bind local:ShellIconConverter.ToLargeImageSource(Entry), Mode=OneWay}"
                                   Width="96"
                                   Height="96"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="✓"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,2,4,0"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Visibility="{x:Bind IsMarked, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{x:Bind Settings.FileListFontSize, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 5. Large Icons View (Große Symbole) -->
            <DataTemplate x:Key="LargeIconsItemTemplate" x:DataType="vm:FileItemViewModel">
                <Border BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="6,4"
                        Width="116"
                        Height="124"
                        Background="Transparent"
                        BorderBrush="{x:Bind local:ShellIconConverter.SelectionBorderBrush(IsFocused, Settings.SelectionBorderColor), Mode=OneWay}"
                        PointerEntered="OnFileItemPointerEntered"
                        PointerMoved="OnFileItemPointerMoved"
                        PointerExited="OnFileItemPointerExited"
                        RightTapped="OnFileItemRightTapped">
                    <Grid Opacity="{x:Bind Opacity, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Image Source="{x:Bind local:ShellIconConverter.ToLargeImageSource(Entry), Mode=OneWay}"
                                   Width="60"
                                   Height="60"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="✓"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,0,2,0"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Visibility="{x:Bind IsMarked, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{x:Bind Settings.FileListFontSize, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 6. Medium Icons View (Mittelgroße Symbole) -->
            <DataTemplate x:Key="MediumIconsItemTemplate" x:DataType="vm:FileItemViewModel">
                <Border BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="4"
                        Width="88"
                        Height="96"
                        Background="Transparent"
                        BorderBrush="{x:Bind local:ShellIconConverter.SelectionBorderBrush(IsFocused, Settings.SelectionBorderColor), Mode=OneWay}"
                        PointerEntered="OnFileItemPointerEntered"
                        PointerMoved="OnFileItemPointerMoved"
                        PointerExited="OnFileItemPointerExited"
                        RightTapped="OnFileItemRightTapped">
                    <Grid Opacity="{x:Bind Opacity, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Image Source="{x:Bind local:ShellIconConverter.ToLargeImageSource(Entry), Mode=OneWay}"
                                   Width="38"
                                   Height="38"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="✓"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                       Visibility="{x:Bind IsMarked, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 7. Small Icons View (Kleine Symbole) -->
            <DataTemplate x:Key="SmallIconsItemTemplate" x:DataType="vm:FileItemViewModel">
                <Border BorderThickness="1.5"
                        CornerRadius="4"
                        Padding="4,2"
                        Width="164"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="{x:Bind local:ShellIconConverter.SelectionBorderBrush(IsFocused, Settings.SelectionBorderColor), Mode=OneWay}"
                        PointerEntered="OnFileItemPointerEntered"
                        PointerMoved="OnFileItemPointerMoved"
                        PointerExited="OnFileItemPointerExited"
                        RightTapped="OnFileItemRightTapped">
                    <Grid Opacity="{x:Bind Opacity, Mode=OneWay}" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="✓"
                                   FontWeight="Bold"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   Visibility="{x:Bind IsMarked, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Image Grid.Column="1"
                               Source="{x:Bind local:ShellIconConverter.ToImageSource(Entry), Mode=OneWay}"
                               Width="18"
                               Height="18"
                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="{x:Bind Settings.FileListFontSize, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 8. List View (Liste) -->
            <DataTemplate x:Key="ListItemTemplate" x:DataType="vm:FileItemViewModel">
                <Border BorderThickness="1.5"
                        CornerRadius="4"
                        Padding="4,1"
                        Width="222"
                        Height="24"
                        Background="Transparent"
                        BorderBrush="{x:Bind local:ShellIconConverter.SelectionBorderBrush(IsFocused, Settings.SelectionBorderColor), Mode=OneWay}"
                        PointerEntered="OnFileItemPointerEntered"
                        PointerMoved="OnFileItemPointerMoved"
                        PointerExited="OnFileItemPointerExited"
                        RightTapped="OnFileItemRightTapped">
                    <Grid Opacity="{x:Bind Opacity, Mode=OneWay}" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="✓"
                                   FontWeight="Bold"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   Visibility="{x:Bind IsMarked, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Image Grid.Column="1"
                               Source="{x:Bind local:ShellIconConverter.ToImageSource(Entry), Mode=OneWay}"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   Foreground="{x:Bind local:ShellIconConverter.ItemTextForeground(IsMarked, Settings.MarkedItemTextColor, Settings.Theme), Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="{x:Bind Settings.FileListFontSize, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= CUSTOM UNIFIED TITLE / HEADER BAR ======================= -->
        <Border Grid.Row="0"
                Background="{ThemeResource ExplorerTitleBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="144" />
                </Grid.ColumnDefinitions>

                <!-- Drag Region (behind interactive buttons) -->
                <Border x:Name="TitleBarDragRegion"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="Transparent" />

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock x:Name="AppTitleTextBlock" Text="ModernExplorer" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="8,2"
                            Visibility="{x:Bind HasText(ViewModel.PendingChordText), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.PendingChordText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.StatusNotification, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           FontSize="12"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Padding="6,0">
                    <Button x:Name="OperationsTitleButton" Content="⚙ Vorgänge" Click="OnToggleOperationsClick" Padding="9,3" FontSize="11.5" />
                    <Button x:Name="DualToggleTitleButton" Content="⇄ Dual / Single (F12)" Click="OnToggleDualClick" Padding="9,3" FontSize="11.5" />
                    <Button x:Name="CommandPaletteTitleButton" Content="⌘ Palette (F10)" Click="OnCommandPaletteClick" Padding="9,3" FontSize="11.5" />
                    <Button x:Name="SettingsTitleButton"
                            Content="⚙ Einstellungen"
                            ToolTipService.ToolTip="Einstellungen öffnen (Strg+,)"
                            Click="OnSettingsClick"
                            Padding="9,3"
                            FontSize="11.5" />
                    <Button x:Name="HelpTitleButton" Content="Hilfe (F1)" Click="OnHelpClick" Padding="9,3" FontSize="11.5" />
                    <Button x:Name="AboutTitleButton"
                            Content="ℹ Über"
                            ToolTipService.ToolTip="Über Modern Explorer, GitHub-Repository &amp; Update-Prüfung"
                            Click="OnAboutClick"
                            Padding="9,3"
                            FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= FAVORITES BAR (Ctrl+D) & POWER-TOOLS BAR ======================= -->
        <Border Grid.Row="1"
                Padding="6,3"
                Background="{ThemeResource ExplorerDriveBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                AllowDrop="True"
                DragOver="OnFavoritesBarDragOver"
                Drop="OnFavoritesBarDrop">
            <StackPanel Spacing="3">
                <!-- Row A: Favorites + Workspace / Basket / Terminal / QuickPreview -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ToggleFavoriteButton"
                            Grid.Column="0"
                            Content="{x:Bind ViewModel.ActivePanel.ActiveTab.BookmarkGlyph, Mode=OneWay}"
                            ToolTipService.ToolTip="Aktuellen Ordner als Favorit speichern / entfernen (Strg+D)"
                            Click="OnToggleBookmarkClick"
                            Padding="7,2"
                            FontSize="13" />

                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Favorites.Items, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fav:FavoriteItem">
                                    <Button Tag="{x:Bind Path}"
                                            ToolTipService.ToolTip="{x:Bind local:ShellIconConverter.OptionalToolTip(ToolTipText, vm:SettingsViewModel.Current.ShowToolTips), Mode=OneWay}"
                                            Click="OnFavoriteItemClick"
                                            RightTapped="OnFavoriteItemRightTapped"
                                            Padding="8,2"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{x:Bind IconGlyph}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Label}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="WorkspacesToolbarButton"
                                Content="🗂 Workspaces"
                                Click="OnWorkspacesClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="FileBasketToolbarButton"
                                Content="🧺 Sammelkorb"
                                Click="OnFileBasketClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="QuickCommandToolbarButton"
                                Content=">_ Konsole"
                                Click="OnToggleQuickCommandBarClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="QuickPreviewToolbarButton"
                                Content="👁 Vorschau"
                                Click="OnToggleQuickPreviewClick"
                                Padding="7,2"
                                FontSize="11.5" />
                    </StackPanel>
                </Grid>

                <!-- Row B: Scrollable Power-Tools Bar -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="UndoToolbarButton"
                                Content="↶ Undo"
                                IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                                Click="OnUndoClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="BatchRenameToolbarButton"
                                Content="✏ Mehrfach-Umbenennen"
                                Click="OnBatchRenameClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="DeepSearchToolbarButton"
                                Content="🔍 Tiefensuche"
                                Click="OnDeepSearchClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="DirectorySyncToolbarButton"
                                Content="⇄ Sync"
                                Click="OnDirectorySyncClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="FileDiffToolbarButton"
                                Content="⚖ Diff"
                                Click="OnFileDiffClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="DuplicateFinderToolbarButton"
                                Content="🧹 Duplikate"
                                Click="OnDuplicateFinderClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="StorageTreemapToolbarButton"
                                Content="🗺 Treemap"
                                Click="OnStorageTreemapClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="ChecksumToolbarButton"
                                Content="🔐 Hashes"
                                Click="OnChecksumClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="SplitShredToolbarButton"
                                Content="✂ Split/Shred"
                                Click="OnSplitShredClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="FileTagToolbarButton"
                                Content="🏷 Tags"
                                Click="OnFileTagClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="AttributesExifToolbarButton"
                                Content="🕒 Attribute/EXIF"
                                Click="OnAttributesExifClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="SmartExportToolbarButton"
                                Content="📋 Export"
                                Click="OnSmartExportClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="PackArchiveToolbarButton"
                                Content="📦 Packen"
                                Click="OnPackArchiveClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="RemoteConnectToolbarButton"
                                Content="🌐 FTP/SFTP"
                                Click="OnRemoteConnectClick"
                                Padding="7,2"
                                FontSize="11.5" />
                        <Button x:Name="GitPanelToolbarButton"
                                Content="⎇ Git"
                                Click="OnGitPanelClick"
                                Padding="7,2"
                                FontSize="11.5" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ======================= DUAL-PANEL WORKSPACE ======================= -->
        <Grid x:Name="PanelsGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT PANEL ==================== -->
            <Border x:Name="LeftPanelBorder"
                    Grid.Column="0"
                    Background="{ThemeResource ExplorerPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemAccentColor}"
                    BorderThickness="2"
                    Margin="2"
                    CornerRadius="4"
                    GotFocus="OnLeftPanelGotFocus"
                    PointerPressed="OnLeftPanelPointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drive Bar Left (above tabs) -->
                    <Border Grid.Row="0"
                            Visibility="{x:Bind ViewModel.Settings.ShowDriveBar, Mode=OneWay}"
                            Padding="6,3"
                            Background="{ThemeResource ExplorerDriveBarBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Left.Drives, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DriveItemViewModel">
                                        <Button Tag="{x:Bind RootPath}"
                                                ToolTipService.ToolTip="{x:Bind local:ShellIconConverter.OptionalToolTip(ToolTip, Settings.ShowToolTips), Mode=OneWay}"
                                                Click="OnLeftDriveClick"
                                                Padding="8,3"
                                                CornerRadius="4"
                                                Background="{x:Bind local:ShellIconConverter.DriveButtonBackground(IsSelected, Settings.ActivePanelBorderColor, Settings.Theme), Mode=OneWay}"
                                                BorderBrush="{x:Bind local:ShellIconConverter.DriveButtonBorderBrush(IsSelected, Settings.ActivePanelBorderColor, Settings.Theme), Mode=OneWay}"
                                                BorderThickness="{x:Bind local:ShellIconConverter.DriveButtonBorderThickness(IsSelected), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Source="{x:Bind local:ShellIconConverter.DriveToImageSource(RootPath)}"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind DisplayText}"
                                                           FontSize="{x:Bind Settings.DriveBarFontSize, Mode=OneWay}"
                                                           FontWeight="{x:Bind local:ShellIconConverter.DriveButtonFontWeight(IsSelected), Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Tab Bar Left -->
                    <Grid Grid.Row="1" Background="{ThemeResource ExplorerTabBarBackgroundBrush}" Padding="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ListView x:Name="LeftTabList"
                                  ItemsSource="{x:Bind ViewModel.Left.Tabs}"
                                  SelectedItem="{x:Bind ViewModel.Left.ActiveTab, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  CanDragItems="True"
                                  CanReorderItems="True"
                                  AllowDrop="True"
                                  DragItemsStarting="OnTabDragStarting"
                                  DragOver="OnTabListDragOver"
                                  Drop="OnLeftTabListDrop"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TabViewModel">
                                    <Grid Padding="6,2"
                                          PointerReleased="OnTabItemPointerReleased"
                                          RightTapped="OnTabItemRightTapped"
                                          AllowDrop="True"
                                          DragOver="OnTabItemFileDragOver"
                                          Drop="OnTabItemFileDrop">
                                        <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                   FontSize="{x:Bind Settings.TabFontSize, Mode=OneWay}"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="LeftNewTabButton" Content="+" Click="OnLeftNewTabClick" Padding="8,2" />
                            <Button x:Name="LeftCloseTabButton" Content="×" Click="OnLeftCloseTabClick" Padding="8,2" />
                        </StackPanel>
                    </Grid>

                    <!-- Navigation + Address + Filter + View Mode Left -->
                    <Grid Grid.Row="2" Padding="6,4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="LeftBackButton" Content="‹" Click="OnLeftBackClick" Padding="8,3" />
                            <Button x:Name="LeftForwardButton" Content="›" Click="OnLeftForwardClick" Padding="8,3" />
                            <Button x:Name="LeftUpButton" Content="↑" Click="OnLeftUpClick" Padding="8,3" />
                            <Button x:Name="LeftRefreshButton" Content="↻" Click="OnLeftRefreshClick" Padding="8,3" />
                            <Button x:Name="LeftBranchViewButton" Content="🌿" Click="OnLeftBranchViewClick" Padding="7,3" />
                            <Button x:Name="LeftTreeSizeButton" Content="📊" Click="OnLeftTreeSizeClick" Padding="7,3" />
                        </StackPanel>

                        <AutoSuggestBox x:Name="LeftAddressBox"
                                        Grid.Column="1"
                                        FontSize="{x:Bind ViewModel.Settings.AddressBarFontSize, Mode=OneWay}"
                                        Text="{x:Bind ViewModel.Left.ActiveTab.AddressText, Mode=TwoWay}"
                                        PlaceholderText="Pfad eingeben …"
                                        TextChanged="OnLeftAddressTextChanged"
                                        QuerySubmitted="OnLeftAddressQuerySubmitted" />

                        <TextBox x:Name="LeftFilterBox"
                                 Grid.Column="2"
                                 FontSize="{x:Bind ViewModel.Settings.AddressBarFontSize, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.Left.ActiveTab.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Filter (Strg+F)" />

                        <Button x:Name="LeftViewModeButton"
                                Grid.Column="3"
                                Content="{x:Bind ViewModel.Left.ActiveTab.ViewModeButtonLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="Anzeigeoptionen umschalten (Strg+Umschalt+1..8)"
                                Click="OnLeftViewModeButtonClick"
                                Padding="8,3"
                                FontSize="{x:Bind ViewModel.Settings.AddressBarFontSize, Mode=OneWay}" />
                    </Grid>

                    <!-- Breadcrumbs + Git Badge Left -->
                    <Grid Grid.Row="3" Padding="6,0,6,4" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Left.ActiveTab.Breadcrumbs, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BreadcrumbSegment">
                                        <Button Content="{x:Bind Label}"
                                                Tag="{x:Bind FullPath}"
                                                Click="OnLeftBreadcrumbClick"
                                                Padding="6,1"
                                                FontSize="{x:Bind Settings.BreadcrumbFontSize, Mode=OneWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1"
                                Visibility="{x:Bind ViewModel.Left.ActiveTab.HasGitRepository, Mode=OneWay}"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                Click="OnLeftGitBadgeClick"
                                CornerRadius="4"
                                Padding="7,1"
                                BorderThickness="0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Left.ActiveTab.GitSummaryBadge, Mode=OneWay}"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <!-- Column Headers Left -->
                    <Grid x:Name="LeftColumnHeaderGrid"
                          Grid.Row="4"
                          Padding="10,4"
                          Background="{ThemeResource ExplorerColumnHeaderBackgroundBrush}"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="75" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnLeftSortNameClick" Padding="4,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="LeftColNameText" Text="Name" FontWeight="SemiBold" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Left.ActiveTab.SortIndicatorName, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"
                                Click="OnLeftSortSizeClick" Padding="4,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="LeftColSizeText" Text="Größe" FontWeight="SemiBold" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Left.ActiveTab.SortIndicatorSize, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnLeftSortModifiedClick" Padding="4,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="LeftColModifiedText" Text="Geändert" FontWeight="SemiBold" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Left.ActiveTab.SortIndicatorModified, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnLeftSortTypeClick" Padding="4,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="LeftColTypeText" Text="Typ" FontWeight="SemiBold" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Left.ActiveTab.SortIndicatorType, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- File List Left -->
                    <ListView x:Name="LeftFileList"
                              Grid.Row="5"
                              IsTabStop="True"
                              TabNavigation="Once"
                              ItemsSource="{x:Bind ViewModel.Left.ActiveTab.Items, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.Left.ActiveTab.FocusedItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemsPanel="{StaticResource VerticalStackItemsPanel}"
                              ItemTemplate="{StaticResource DetailsItemTemplate}"
                              DoubleTapped="OnLeftListDoubleTapped"
                              GotFocus="OnLeftListGotFocus"
                              CharacterReceived="OnLeftListCharacterReceived">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="22" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Status Bar Left -->
                    <Border Grid.Row="6"
                            Padding="8,4"
                            Background="{ThemeResource ExplorerStatusBarBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Left.ActiveTab.StatusSummary, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.Settings.StatusBarFontSize, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Left.ActiveTab.DriveSummary, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.Settings.StatusBarFontSize, Mode=OneWay}"
                                       Opacity="0.75"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== SPLITTER ==================== -->
            <Border x:Name="SplitterBar"
                    Grid.Column="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Width="4"
                    HorizontalAlignment="Center" />

            <!-- ==================== RIGHT PANEL ==================== -->
            <Border x:Name="RightPanelBorder"
                    Grid.Column="2"
                    Background="{ThemeResource ExplorerPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Margin="2"
                    CornerRadius="4"
                    GotFocus="OnRightPanelGotFocus"
                    PointerPressed="OnRightPanelPointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drive Bar Right (above tabs) -->
                    <Border Grid.Row="0"
                            Visibility="{x:Bind ViewModel.Settings.ShowDriveBar, Mode=OneWay}"
                            Padding="6,3"
                            Background="{ThemeResource ExplorerDriveBarBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Right.Drives, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DriveItemViewModel">
                                        <Button Tag="{x:Bind RootPath}"
                                                ToolTipService.ToolTip="{x:Bind local:ShellIconConverter.OptionalToolTip(ToolTip, Settings.ShowToolTips), Mode=OneWay}"
                                                Click="OnRightDriveClick"
                                                Padding="8,3"
                                                CornerRadius="4"
                                                Background="{x:Bind local:ShellIconConverter.DriveButtonBackground(IsSelected, Settings.ActivePanelBorderColor, Settings.Theme), Mode=OneWay}"
                                                BorderBrush="{x:Bind local:ShellIconConverter.DriveButtonBorderBrush(IsSelected, Settings.ActivePanelBorderColor, Settings.Theme), Mode=OneWay}"
                                                BorderThickness="{x:Bind local:ShellIconConverter.DriveButtonBorderThickness(IsSelected), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Source="{x:Bind local:ShellIconConverter.DriveToImageSource(RootPath)}"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind DisplayText}"
                                                           FontSize="{x:Bind Settings.DriveBarFontSize, Mode=OneWay}"
                                                           FontWeight="{x:Bind local:ShellIconConverter.DriveButtonFontWeight(IsSelected), Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Tab Bar Right -->
                    <Grid Grid.Row="1" Background="{ThemeResource ExplorerTabBarBackgroundBrush}" Padding="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ListView x:Name="RightTabList"
                                  ItemsSource="{x:Bind ViewModel.Right.Tabs}"
                                  SelectedItem="{x:Bind ViewModel.Right.ActiveTab, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  CanDragItems="True"
                                  CanReorderItems="True"
                                  AllowDrop="True"
                                  DragItemsStarting="OnTabDragStarting"
                                  DragOver="OnTabListDragOver"
                                  Drop="OnRightTabListDrop"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TabViewModel">
                                    <Grid Padding="6,2"
                                          PointerReleased="OnTabItemPointerReleased"
                                          RightTapped="OnTabItemRightTapped"
                                          AllowDrop="True"
                                          DragOver="OnTabItemFileDragOver"
                                          Drop="OnTabItemFileDrop">
                                        <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                   FontSize="{x:Bind Settings.TabFontSize, Mode=OneWay}"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="RightNewTabButton" Content="+" Click="OnRightNewTabClick" Padding="8,2" />
                            <Button x:Name="RightCloseTabButton" Content="×" Click="OnRightCloseTabClick" Padding="8,2" />
                        </StackPanel>
                    </Grid>

                    <!-- Navigation + Address + Filter + View Mode Right -->
                    <Grid Grid.Row="2" Padding="6,4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="RightBackButton" Content="‹" Click="OnRightBackClick" Padding="8,3" />
                            <Button x:Name="RightForwardButton" Content="›" Click="OnRightForwardClick" Padding="8,3" />
                            <Button x:Name="RightUpButton" Content="↑" Click="OnRightUpClick" Padding="8,3" />
                            <Button x:Name="RightRefreshButton" Content="↻" Click="OnRightRefreshClick" Padding="8,3" />
                            <Button x:Name="RightBranchViewButton" Content="🌿" Click="OnRightBranchViewClick" Padding="7,3" />
                            <Button x:Name="RightTreeSizeButton" Content="📊" Click="OnRightTreeSizeClick" Padding="7,3" />
                        </StackPanel>

                        <AutoSuggestBox x:Name="RightAddressBox"
                                        Grid.Column="1"
                                        FontSize="{x:Bind ViewModel.Settings.AddressBarFontSize, Mode=OneWay}"
                                        Text="{x:Bind ViewModel.Right.ActiveTab.AddressText, Mode=TwoWay}"
                                        PlaceholderText="Pfad eingeben …"
                                        TextChanged="OnRightAddressTextChanged"
                                        QuerySubmitted="OnRightAddressQuerySubmitted" />

                        <TextBox x:Name="RightFilterBox"
                                 Grid.Column="2"
                                 FontSize="{x:Bind ViewModel.Settings.AddressBarFontSize, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.Right.ActiveTab.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Filter (Strg+F)" />

                        <Button x:Name="RightViewModeButton"
                                Grid.Column="3"
                                Content="{x:Bind ViewModel.Right.ActiveTab.ViewModeButtonLabel, Mode=OneWay}"
                                Click="OnRightViewModeButtonClick"
                                Padding="8,3"
                                FontSize="{x:Bind ViewModel.Settings.AddressBarFontSize, Mode=OneWay}" />
                    </Grid>

                    <!-- Breadcrumbs + Git Badge Right -->
                    <Grid Grid.Row="3" Padding="6,0,6,4" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Right.ActiveTab.Breadcrumbs, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BreadcrumbSegment">
                                        <Button Content="{x:Bind Label}"
                                                Tag="{x:Bind FullPath}"
                                                Click="OnRightBreadcrumbClick"
                                                Padding="6,1"
                                                FontSize="{x:Bind Settings.BreadcrumbFontSize, Mode=OneWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1"
                                Visibility="{x:Bind ViewModel.Right.ActiveTab.HasGitRepository, Mode=OneWay}"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                Click="OnRightGitBadgeClick"
                                CornerRadius="4"
                                Padding="7,1"
                                BorderThickness="0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Right.ActiveTab.GitSummaryBadge, Mode=OneWay}"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <!-- Column Headers Right -->
                    <Grid x:Name="RightColumnHeaderGrid"
                          Grid.Row="4"
                          Padding="10,4"
                          Background="{ThemeResource ExplorerColumnHeaderBackgroundBrush}"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="75" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnRightSortNameClick" Padding="4,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="RightColNameText" Text="Name" FontWeight="SemiBold" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Right.ActiveTab.SortIndicatorName, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"
                                Click="OnRightSortSizeClick" Padding="4,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="RightColSizeText" Text="Größe" FontWeight="SemiBold" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Right.ActiveTab.SortIndicatorSize, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnRightSortModifiedClick" Padding="4,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="RightColModifiedText" Text="Geändert" FontWeight="SemiBold" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Right.ActiveTab.SortIndicatorModified, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnRightSortTypeClick" Padding="4,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="RightColTypeText" Text="Typ" FontWeight="SemiBold" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Right.ActiveTab.SortIndicatorType, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.FileListDetailsFontSize, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- File List Right -->
                    <ListView x:Name="RightFileList"
                              Grid.Row="5"
                              IsTabStop="True"
                              TabNavigation="Once"
                              ItemsSource="{x:Bind ViewModel.Right.ActiveTab.Items, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.Right.ActiveTab.FocusedItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemsPanel="{StaticResource VerticalStackItemsPanel}"
                              ItemTemplate="{StaticResource DetailsItemTemplate}"
                              DoubleTapped="OnRightListDoubleTapped"
                              GotFocus="OnRightListGotFocus"
                              CharacterReceived="OnRightListCharacterReceived">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="22" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Status Bar Right -->
                    <Border Grid.Row="6"
                            Padding="8,4"
                            Background="{ThemeResource ExplorerStatusBarBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Right.ActiveTab.StatusSummary, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.Settings.StatusBarFontSize, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Right.ActiveTab.DriveSummary, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.Settings.StatusBarFontSize, Mode=OneWay}"
                                       Opacity="0.75"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== INTEGRATED QUICK-PREVIEW PANEL (Strg+Q) ==================== -->
            <Border x:Name="QuickPreviewPanelBorder"
                    Grid.Column="3"
                    Width="340"
                    Visibility="{x:Bind ViewModel.IsQuickPreviewPanelOpen, Mode=OneWay}"
                    Background="{ThemeResource ExplorerPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Margin="2"
                    CornerRadius="4">
                <Grid Padding="10" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="QuickPreviewTitleText"
                                   Text="👁 Schnellvorschau (Strg+Q)"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button x:Name="QuickPreviewCloseButton"
                                Grid.Column="1"
                                Content="×"
                                Click="OnToggleQuickPreviewClick"
                                Padding="7,2" />
                    </Grid>

                    <TextBlock x:Name="QuickPreviewMetaText"
                               Grid.Row="1"
                               FontSize="11.5"
                               Opacity="0.75"
                               TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <Border x:Name="QuickPreviewImageContainer"
                                Visibility="Collapsed"
                                Background="{ThemeResource ExplorerCardBackgroundBrush}"
                                CornerRadius="6"
                                Padding="6">
                            <Image x:Name="QuickPreviewImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <TextBox x:Name="QuickPreviewTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= OPERATIONS PANEL ======================= -->
        <Border Grid.Row="3"
                Visibility="{x:Bind ViewModel.IsOperationsPanelOpen, Mode=OneWay}"
                MaxHeight="150"
                Padding="10,6"
                Background="{ThemeResource ExplorerStatusBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="OperationsPanelTitleText" Text="Hintergrund-Vorgänge" FontWeight="SemiBold" FontSize="12" />
                    <Button x:Name="OperationsHideButton"
                            Content="Ausblenden"
                            HorizontalAlignment="Right"
                            Click="OnToggleOperationsClick"
                            Padding="6,1"
                            FontSize="11" />
                </Grid>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Operations}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:OperationItemViewModel">
                            <Grid ColumnSpacing="10" Padding="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Title, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" Value="{x:Bind ProgressPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DetailText, Mode=OneWay}" FontSize="11.5" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                    <Button Content="{x:Bind PauseResumeLabel, Mode=OneWay}"
                                            Command="{x:Bind TogglePauseCommand}"
                                            Visibility="{x:Bind CanPauseOrResume, Mode=OneWay}"
                                            Padding="6,2"
                                            FontSize="11" />
                                    <Button Content="{x:Bind CancelLabel, Mode=OneWay}"
                                            Command="{x:Bind CancelCommand}"
                                            Visibility="{x:Bind CanCancel, Mode=OneWay}"
                                            Padding="6,2"
                                            FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ======================= EMBEDDED QUICK COMMAND BAR (>_ Strg+Shift+J) ======================= -->
        <Border x:Name="QuickCommandBarBorder"
                Grid.Row="4"
                Visibility="{x:Bind ViewModel.IsQuickCommandBarOpen, Mode=OneWay}"
                Background="{ThemeResource ExplorerStatusBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- Collapsible Terminal Output Drawer -->
                <Border x:Name="QuickCommandOutputBorder"
                        Visibility="Collapsed"
                        Padding="10,6"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="QuickCommandOutputHeaderText"
                                       Text=">_ Konsolenausgabe"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button x:Name="QuickCommandCopyOutputButton"
                                        Content="📋 Kopieren"
                                        Click="OnQuickCommandCopyOutputClick"
                                        Padding="7,1"
                                        FontSize="11" />
                                <Button x:Name="QuickCommandClearOutputButton"
                                        Content="🧹 Leeren"
                                        Click="OnQuickCommandClearOutputClick"
                                        Padding="7,1"
                                        FontSize="11" />
                                <Button x:Name="QuickCommandHideOutputButton"
                                        Content="▼ Ausblenden"
                                        Click="OnQuickCommandHideOutputClick"
                                        Padding="7,1"
                                        FontSize="11" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="QuickCommandOutputBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 Height="135"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!-- Inline Command Input Row -->
                <Grid Padding="8,4" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{ThemeResource ExplorerCardBackgroundBrush}"
                            CornerRadius="4"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="QuickCommandPromptText"
                                   Text="PS &gt;"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBox x:Name="QuickCommandInputBox"
                             Grid.Column="1"
                             FontFamily="Consolas"
                             FontSize="12"
                             PlaceholderText="Befehl eingeben (Enter = Ausführen, ↑/↓ = Verlauf, cd &lt;Ordner&gt;, Esc = Dateiliste) …"
                             KeyDown="OnQuickCommandInputKeyDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="QuickCommandRunButton"
                                Content="▶ Ausführen"
                                Click="OnQuickCommandRunClick"
                                Padding="9,3"
                                FontSize="11.5" />
                        <Button x:Name="QuickCommandToggleOutputButton"
                                Content="📜 Ausgabe"
                                Click="OnQuickCommandToggleOutputClick"
                                Padding="8,3"
                                FontSize="11.5" />
                        <Button x:Name="QuickCommandExternalButton"
                                Content="🖥 Terminal (F9)"
                                Click="OnF9Click"
                                Padding="8,3"
                                FontSize="11.5" />
                        <Button x:Name="QuickCommandCloseButton"
                                Content="×"
                                Click="OnToggleQuickCommandBarClick"
                                Padding="7,3"
                                FontSize="11.5" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======================= FUNCTION KEY BAR (F1-F12) ======================= -->
        <Border Grid.Row="5"
                Visibility="{x:Bind ViewModel.Settings.ShowFunctionKeyBar, Mode=OneWay}"
                Padding="6,4"
                Background="{ThemeResource ExplorerFunctionBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="FnF1Button" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnF1Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F1', ViewModel.F1Label), Mode=OneWay}" />
                <Button x:Name="FnF2Button" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnF2Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F2', ViewModel.F2Label), Mode=OneWay}" />
                <Button x:Name="FnF3Button" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnF3Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F3', ViewModel.F3Label), Mode=OneWay}" />
                <Button x:Name="FnF4Button" Grid.Column="3" HorizontalAlignment="Stretch" Click="OnF4Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F4', ViewModel.F4Label), Mode=OneWay}" />
                <Button x:Name="FnF5Button" Grid.Column="4" HorizontalAlignment="Stretch" Click="OnF5Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F5', ViewModel.F5Label), Mode=OneWay}" />
                <Button x:Name="FnF6Button" Grid.Column="5" HorizontalAlignment="Stretch" Click="OnF6Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F6', ViewModel.F6Label), Mode=OneWay}" />
                <Button x:Name="FnF7Button" Grid.Column="6" HorizontalAlignment="Stretch" Click="OnF7Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" FontWeight="SemiBold" Content="{x:Bind FormatFKey('F7', ViewModel.F7Label), Mode=OneWay}" />
                <Button x:Name="FnF8Button" Grid.Column="7" HorizontalAlignment="Stretch" Click="OnF8Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F8', ViewModel.F8Label), Mode=OneWay}" />
                <Button x:Name="FnF9Button" Grid.Column="8" HorizontalAlignment="Stretch" Click="OnF9Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F9', ViewModel.F9Label), Mode=OneWay}" />
                <Button x:Name="FnF10Button" Grid.Column="9" HorizontalAlignment="Stretch" Click="OnF10Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F10', ViewModel.F10Label), Mode=OneWay}" />
                <Button x:Name="FnF11Button" Grid.Column="10" HorizontalAlignment="Stretch" Click="OnF11Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F11', ViewModel.F11Label), Mode=OneWay}" />
                <Button x:Name="FnF12Button" Grid.Column="11" HorizontalAlignment="Stretch" Click="OnF12Click" Padding="4,3" FontSize="{x:Bind ViewModel.Settings.FunctionBarFontSize, Mode=OneWay}" Content="{x:Bind FormatFKey('F12', ViewModel.F12Label), Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- ======================= IMAGE HOVER PREVIEW ======================= -->
        <Canvas x:Name="ImageHoverCanvas"
                Grid.Row="0"
                Grid.RowSpan="6"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border x:Name="ImageHoverCard"
                    Canvas.Left="24"
                    Canvas.Top="24"
                    MaxWidth="{x:Bind ViewModel.Settings.ImageHoverCardMaxWidth, Mode=OneWay}"
                    Background="{ThemeResource ExplorerSettingsBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemAccentColor}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel Spacing="6">
                    <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                            CornerRadius="6"
                            Padding="4"
                            HorizontalAlignment="Center">
                        <Image x:Name="HoverPreviewImage"
                               MaxWidth="{x:Bind ViewModel.Settings.ImageHoverPreviewSize, Mode=OneWay}"
                               MaxHeight="{x:Bind ViewModel.Settings.ImageHoverPreviewHeight, Mode=OneWay}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="HoverPreviewTitle"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HoverPreviewMeta"
                               FontSize="11.5"
                               Opacity="0.8" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>


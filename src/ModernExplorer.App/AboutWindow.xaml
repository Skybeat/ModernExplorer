<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernExplorer.App.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Über Modern Explorer">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ExplorerSettingsBackgroundBrush}"
          KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <!-- Custom TitleBar -->
            <RowDefinition Height="40" />
            <!-- Main About Content -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= CUSTOM TITLE BAR ======================= -->
        <Border Grid.Row="0"
                Background="{ThemeResource ExplorerTitleBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AboutTitleBarDragRegion" Grid.Column="0" Background="Transparent" />

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Image Source="ms-appx:///Assets/AppIcon.png"
                           Width="16"
                           Height="16"
                           VerticalAlignment="Center" />
                    <TextBlock Text="ℹ" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock x:Name="WindowTitleLabel"
                               Text="Über Modern Explorer"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= MAIN BODY ======================= -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,20">
            <StackPanel Spacing="16">

                <!-- App Header & Description Card -->
                <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Image Source="ms-appx:///Assets/AppIcon.png"
                                   Width="48"
                                   Height="48"
                                   VerticalAlignment="Center" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="AppHeadingLabel"
                                           Text="Modern Explorer"
                                           FontSize="20"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="AppSubtitleLabel"
                                           Text="Dual-Pane Datei-Explorer für Windows, Linux &amp; macOS"
                                           FontSize="12.5"
                                           Opacity="0.8" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="AppDescriptionLabel"
                                   Text="Modern Explorer ist ein schneller, tastaturzentrierter Dual-Pane Datei-Explorer im Commander-Stil mit Tab-Management, intelligenter Schnellansicht (F3), integriertem Editor (F4), Hintergrund-Operationen und Live-Design-Anpassung."
                                   FontSize="13"
                                   Opacity="0.85"
                                   TextWrapping="Wrap" />

                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="RepositoryHeaderLabel"
                                           Text="GitHub-Repository:"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.75" />
                                <HyperlinkButton x:Name="RepositoryLinkButton"
                                                 Content="https://github.com/Skybeat/ModernExplorer"
                                                 Click="OnOpenRepositoryClick"
                                                 Padding="0,2"
                                                 FontSize="13" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version & GitHub Update Check Card -->
                <Border Background="{ThemeResource ExplorerCardBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="VersionSectionTitleLabel"
                                   Text="Versionsinformationen &amp; Update-Status"
                                   FontSize="15"
                                   FontWeight="SemiBold" />

                        <Grid RowSpacing="8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="InstalledVersionTitleLabel"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Aktuell installierte Version:"
                                       FontSize="13"
                                       Opacity="0.8"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="InstalledVersionValueLabel"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Text="1.0.1"
                                       FontFamily="Consolas"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <TextBlock x:Name="LatestVersionTitleLabel"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Gefundene Version auf GitHub:"
                                       FontSize="13"
                                       Opacity="0.8"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="LatestVersionValueLabel"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Text="—"
                                       FontFamily="Consolas"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border x:Name="UpdateStatusBanner"
                                CornerRadius="6"
                                Padding="12,8"
                                Background="{ThemeResource ExplorerPanelBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="UpdateStatusText"
                                       Text="Prüfe auf GitHub nach einer neueren Version …"
                                       FontSize="12.5"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Multi-line Scrollable Release Notes + Direct Browser Link -->
                        <StackPanel x:Name="ReleaseNotesSectionPanel"
                                    Visibility="Collapsed"
                                    Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReleaseNotesHeaderLabel"
                                           Grid.Column="0"
                                           Text="📋 Änderungen in diesem Release:"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="OpenReleaseBrowserLink"
                                                 Grid.Column="1"
                                                 Content="🌐 Auf GitHub ansehen ↗"
                                                 Click="OnOpenReleaseInBrowserClick"
                                                 Padding="6,2"
                                                 FontSize="12.5"
                                                 VerticalAlignment="Center" />
                            </Grid>

                            <Border CornerRadius="6"
                                    Padding="12,10,8,10"
                                    Background="{ThemeResource ExplorerPanelBackgroundBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <ScrollViewer Height="200"
                                              MinHeight="150"
                                              MaxHeight="260"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="ReleaseNotesBodyText"
                                               Text=""
                                               FontSize="12.5"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               Padding="2,0,6,2" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="UpdateNowButton"
                                    Content="🚀 Jetzt aktualisieren"
                                    Visibility="Collapsed"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnUpdateNowClick"
                                    Padding="14,7"
                                    FontWeight="SemiBold" />
                            <Button x:Name="CheckAgainButton"
                                    Content="Erneut prüfen"
                                    Click="OnCheckAgainClick"
                                    Padding="12,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ======================= FOOTER ======================= -->
        <Border Grid.Row="2"
                Padding="20,10"
                Background="{ThemeResource ExplorerStatusBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="Modern Explorer · MIT License · github.com/Skybeat/ModernExplorer"
                           FontSize="11.5"
                           Opacity="0.65"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseAboutButton"
                        Content="Schließen (Esc)"
                        HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        Padding="18,6" />
            </Grid>
        </Border>
    </Grid>
</Window>


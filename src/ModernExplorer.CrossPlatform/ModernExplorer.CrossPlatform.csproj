<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ModernExplorer.CrossPlatform</RootNamespace>
    <AssemblyName>ModernExplorer</AssemblyName>
    <ApplicationIcon>..\ModernExplorer.App\Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.6.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SelfContained>true</SelfContained>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\ModernExplorer.App\Assets\AppIcon.png" Link="Assets\AppIcon.png" />
    <AvaloniaResource Include="..\ModernExplorer.App\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
    <Content Include="..\ModernExplorer.App\Assets\AppIcon.png" Link="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ModernExplorer.App\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernExplorer.Core\ModernExplorer.Core.csproj" />
  </ItemGroup>

  <!-- Bundle 32-bit Microsoft Visual C++ Runtime DLLs for win-x86 so no external VC++ Redistributable is required -->
  <Target Name="BundleVcRuntimeDllsX86" AfterTargets="Build;Publish" Condition="'$(RuntimeIdentifier)' == 'win-x86' And Exists('$(SystemRoot)\SysWOW64\vcruntime140.dll')">
    <ItemGroup>
      <_VcCrtDllsX86 Include="$(SystemRoot)\SysWOW64\vcruntime140.dll" Condition="Exists('$(SystemRoot)\SysWOW64\vcruntime140.dll')" />
      <_VcCrtDllsX86 Include="$(SystemRoot)\SysWOW64\msvcp140.dll" Condition="Exists('$(SystemRoot)\SysWOW64\msvcp140.dll')" />
      <_VcCrtDllsX86 Include="$(SystemRoot)\SysWOW64\msvcp140_1.dll" Condition="Exists('$(SystemRoot)\SysWOW64\msvcp140_1.dll')" />
      <_VcCrtDllsX86 Include="$(SystemRoot)\SysWOW64\msvcp140_2.dll" Condition="Exists('$(SystemRoot)\SysWOW64\msvcp140_2.dll')" />
      <_VcCrtDllsX86 Include="$(SystemRoot)\SysWOW64\concrt140.dll" Condition="Exists('$(SystemRoot)\SysWOW64\concrt140.dll')" />
      <_VcCrtDllsX86 Include="$(SystemRoot)\SysWOW64\vccorlib140.dll" Condition="Exists('$(SystemRoot)\SysWOW64\vccorlib140.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_VcCrtDllsX86)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'$(OutDir)' != '' And Exists('$(OutDir)')" />
    <Copy SourceFiles="@(_VcCrtDllsX86)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)')" />
  </Target>

</Project>


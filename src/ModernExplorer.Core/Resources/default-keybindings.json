{
  "version": 1,
  "bindings": [
    { "key": "F1",              "command": "app.help",                 "when": "global" },
    { "key": "F2",              "command": "file.rename",              "when": "fileList && hasFocusedItem" },
    { "key": "F3",              "command": "file.view",                "when": "fileList && hasFocusedItem" },
    { "key": "F4",              "command": "file.edit",                "when": "fileList && hasFocusedItem" },
    { "key": "F5",              "command": "fileOp.copy",              "when": "fileList", "args": { "target": "oppositePanel" } },
    { "key": "Shift+F5",        "command": "fileOp.copy",              "when": "fileList", "args": { "showDialog": true } },
    { "key": "F6",              "command": "fileOp.move",              "when": "fileList", "args": { "target": "oppositePanel" } },
    { "key": "Shift+F6",        "command": "fileOp.move",              "when": "fileList", "args": { "showDialog": true } },
    { "key": "F7",              "command": "file.createNew",           "when": "fileList" },
    { "key": "Shift+F7",        "command": "folder.createNew",         "when": "fileList" },
    { "key": "F8",              "command": "fileOp.delete",            "when": "fileList", "args": { "recycle": true } },
    { "key": "Delete",          "command": "fileOp.delete",            "when": "fileList", "args": { "recycle": true } },
    { "key": "Shift+F8",        "command": "fileOp.delete",            "when": "fileList", "args": { "recycle": false } },
    { "key": "Shift+Delete",    "command": "fileOp.delete",            "when": "fileList", "args": { "recycle": false } },
    { "key": "F9",              "command": "terminal.open",            "when": "global" },
    { "key": "Shift+F9",        "command": "terminal.open",            "when": "global", "args": { "elevated": true } },
    { "key": "F10",             "command": "palette.open",             "when": "global" },
    { "key": "Ctrl+Shift+P",    "command": "palette.open",             "when": "global", "allowInTextInput": true },
    { "key": "F11",             "command": "view.fullscreen",          "when": "global" },
    { "key": "F12",             "command": "layout.toggleDual",        "when": "global" },
    { "key": "Shift+F12",       "command": "layout.swapPanels",        "when": "global" },
    { "key": "Ctrl+F12",        "command": "layout.syncPanels",        "when": "global" },

    { "key": "Ctrl+F3",         "command": "view.sort",                "when": "panel", "args": { "column": "name" } },
    { "key": "Ctrl+F6",         "command": "view.sort",                "when": "panel", "args": { "column": "modified" } },
    { "key": "Ctrl+F8",         "command": "view.sort",                "when": "panel", "args": { "column": "size" } },
    { "key": "Ctrl+F9",         "command": "view.sort",                "when": "panel", "args": { "column": "type" } },
    { "key": "Ctrl+F5",         "command": "view.refresh",             "when": "panel" },
    { "key": "Ctrl+R",          "command": "view.refresh",             "when": "panel" },
    { "key": "Ctrl+H",          "command": "view.toggleHidden",        "when": "panel" },

    { "key": "Enter",           "command": "nav.open",                 "when": "fileList && hasFocusedItem" },
    { "key": "Ctrl+Enter",      "command": "nav.openInBackgroundTab",  "when": "fileList && hasFocusedItem" },
    { "key": "Shift+Enter",     "command": "nav.openInOppositePanel",  "when": "fileList && hasFocusedItem" },
    { "key": "Back",            "command": "nav.up",                   "when": "fileList" },
    { "key": "Alt+Up",          "command": "nav.up",                   "when": "panel" },
    { "key": "Alt+Left",        "command": "nav.back",                 "when": "panel" },
    { "key": "Alt+Right",       "command": "nav.forward",              "when": "panel" },
    { "key": "Ctrl+L",          "command": "nav.focusAddress",         "when": "global", "allowInTextInput": true },
    { "key": "Alt+D",           "command": "nav.focusAddress",         "when": "global", "allowInTextInput": true },
    { "key": "Ctrl+F",          "command": "filter.focus",             "when": "global", "allowInTextInput": true },
    { "key": "Tab",             "command": "panel.switch",             "when": "global" },
    { "key": "Shift+Tab",       "command": "panel.switch",             "when": "global" },
    { "key": "Escape",          "command": "panel.focusList",          "when": "global", "allowInTextInput": true },

    { "key": "Space",           "command": "select.toggle",            "when": "fileList && hasFocusedItem" },
    { "key": "Insert",          "command": "select.toggle",            "when": "fileList && hasFocusedItem" },
    { "key": "Ctrl+A",          "command": "select.all",               "when": "fileList" },
    { "key": "Multiply",        "command": "select.invert",            "when": "fileList" },
    { "key": "Ctrl+Shift+C",    "command": "clipboard.copyPath",       "when": "fileList" },
    { "key": "Ctrl+C",          "command": "clipboard.copy",           "when": "fileList" },
    { "key": "Ctrl+X",          "command": "clipboard.cut",            "when": "fileList" },
    { "key": "Ctrl+V",          "command": "clipboard.paste",          "when": "fileList" },

    { "key": "Ctrl+T",          "command": "tab.new",                  "when": "global" },
    { "key": "Ctrl+W",          "command": "tab.close",                "when": "global" },
    { "key": "Ctrl+F4",         "command": "tab.close",                "when": "global" },
    { "key": "Ctrl+Shift+T",    "command": "tab.reopen",               "when": "global" },
    { "key": "Ctrl+Shift+D",    "command": "tab.duplicate",            "when": "global" },
    { "key": "Ctrl+K Ctrl+P",   "command": "tab.togglePin",            "when": "global" },
    { "key": "Ctrl+K Ctrl+L",   "command": "tab.toggleLock",           "when": "global" },
    { "key": "Ctrl+Tab",        "command": "tab.next",                 "when": "global", "allowInTextInput": true },
    { "key": "Ctrl+PageDown",   "command": "tab.next",                 "when": "global", "allowInTextInput": true },
    { "key": "Ctrl+Shift+Tab",  "command": "tab.previous",             "when": "global", "allowInTextInput": true },
    { "key": "Ctrl+PageUp",     "command": "tab.previous",             "when": "global", "allowInTextInput": true },
    { "key": "Ctrl+1",          "command": "tab.goto",                 "when": "global", "args": { "index": 0 } },
    { "key": "Ctrl+2",          "command": "tab.goto",                 "when": "global", "args": { "index": 1 } },
    { "key": "Ctrl+3",          "command": "tab.goto",                 "when": "global", "args": { "index": 2 } },
    { "key": "Ctrl+4",          "command": "tab.goto",                 "when": "global", "args": { "index": 3 } },
    { "key": "Ctrl+5",          "command": "tab.goto",                 "when": "global", "args": { "index": 4 } },
    { "key": "Ctrl+6",          "command": "tab.goto",                 "when": "global", "args": { "index": 5 } },
    { "key": "Ctrl+7",          "command": "tab.goto",                 "when": "global", "args": { "index": 6 } },
    { "key": "Ctrl+8",          "command": "tab.goto",                 "when": "global", "args": { "index": 7 } },
    { "key": "Ctrl+9",          "command": "tab.gotoLast",             "when": "global" },
    { "key": "Ctrl+Shift+Left", "command": "tab.moveToOppositePanel",  "when": "global" },
    { "key": "Ctrl+Shift+Right","command": "tab.moveToOppositePanel",  "when": "global" },
    { "key": "Ctrl+Shift+PageUp",   "command": "tab.moveLeft",         "when": "global" },
    { "key": "Ctrl+Shift+PageDown", "command": "tab.moveRight",        "when": "global" },
    { "key": "Ctrl+Shift+N",    "command": "window.newWithTab",        "when": "global" },

    { "key": "Ctrl+M",          "command": "file.batchRename",         "when": "fileList" },
    { "key": "Ctrl+Z",          "command": "edit.undo",                "when": "fileList" },
    { "key": "Ctrl+B",          "command": "view.branchView",          "when": "panel" },
    { "key": "Ctrl+Q",          "command": "view.quickPreview",        "when": "global" },
    { "key": "Ctrl+D",          "command": "favorites.toggle",         "when": "global" },
    { "key": "Alt+F7",          "command": "tools.deepSearch",         "when": "global" },
    { "key": "Ctrl+Shift+F",    "command": "tools.deepSearch",         "when": "global" },
    { "key": "Ctrl+Shift+S",    "command": "tools.syncDirs",           "when": "global" },
    { "key": "Ctrl+Shift+W",    "command": "tools.storageTreemap",     "when": "global" },
    { "key": "Alt+F5",          "command": "archive.pack",             "when": "fileList" },
    { "key": "Alt+F9",          "command": "archive.extract",          "when": "fileList" },

    { "key": "Ctrl+Shift+1",    "command": "view.mode.extraLargeIcons","when": "panel" },
    { "key": "Ctrl+Shift+2",    "command": "view.mode.largeIcons",     "when": "panel" },
    { "key": "Ctrl+Shift+3",    "command": "view.mode.mediumIcons",    "when": "panel" },
    { "key": "Ctrl+Shift+4",    "command": "view.mode.smallIcons",     "when": "panel" },
    { "key": "Ctrl+Shift+5",    "command": "view.mode.list",           "when": "panel" },
    { "key": "Ctrl+Shift+6",    "command": "view.mode.details",        "when": "panel" },
    { "key": "Ctrl+Shift+7",    "command": "view.mode.tiles",          "when": "panel" },
    { "key": "Ctrl+Shift+8",    "command": "view.mode.content",        "when": "panel" }
  ]
}


